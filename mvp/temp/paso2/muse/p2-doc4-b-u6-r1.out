 "dudas": [
  {"id": "Q1", "texto": "«Ella» en [14] puede referirse a la personera (C1) o a la secretaria de la junta de acción comunal (C2); el quién de K2 y el agente de la petición quedan sin resolver.", "respaldo": [{"o": 14, "f": "Ella pidió"}]},
  {"id": "Q2", "texto": "«Su» en [15] («Su reclamo»): puede ser el reclamo de la personera (C1) o de la secretaria (C2).", "respaldo": [{"o": 15, "f": "Su reclamo"}]},
  {"id": "Q3", "texto": "«Su» en [16] («Su decisión»): puede ser la decisión de la personera (C1), de la secretaria (C2) o de la empresa de acueducto (C3).", "respaldo": [{"o": 16, "f": "Su decisión"}]},
  {"id": "Q4", "texto": "«la solicitud» en [17]: puede ser el pedido de publicar el cronograma [14], el reclamo registrado en el acta [15] u otra solicitud no especificada en la unidad.", "respaldo": [{"o": 17, "f": "evaluará la solicitud"}, {"o": 14, "f": "que se publicara el cronograma"}, {"o": 15, "f": "Su reclamo"}]}
 ]
